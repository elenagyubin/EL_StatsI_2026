# remove objects
rm(list=ls())
detachAllPackages()
# create vector y
y <- c(0, 4, 4, 5, 7, 10)
# (1) find sum of y using the built-in R function
sum(y)
# (2) find mean of y using your "own" function
# now do the same thing, but faster using the built-in R function
mean(y)
# (2) find mean of y using your "own" function
sum(y)/length(y)
# (3) find sum of demeaned values
# demean ≈ deviation
y - mean(y)
# (4) calculate sum of squared error
deviations <- y - mean(y)
deviations^2
squared_error <- deviations^2
sum(squared_error)
demeaned_values <- y - mean(y)
sum(demeaned_values)
sum(demeaned_values)
# remove objects
rm(list=ls())
# create vector y
y <- c(0, 4, 4, 5, 7, 10)
# (1) find sum of y using the built-in R function
sum(y)
# (2) find mean of y using your "own" function
sum(y)/length(y)
# now do the same thing, but faster using the built-in R function
mean(y)
# (3) find sum of demeaned values
# demean ≈ deviation (?)
y - mean(y)
demeaned_values <- y - mean(y)
sum(demeaned_values)
# (4) calculate sum of squared error
squared_error <- deviations^2
# (4) calculate sum of squared error
squared_error <- demeaned_values^2
sum(squared_error)
sum(squared_error)
IRkernel::installspec()
