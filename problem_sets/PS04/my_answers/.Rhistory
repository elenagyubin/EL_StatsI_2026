data(Prestige)
help(Prestige)
head(Prestige)
table(Prestige$type, useNA = "ifany")  # 4 occupations have type = NA
Prestige$professional <- ifelse(Prestige$type == "prof", 1, 0)
table(Prestige$professional, useNA = "ifany")
model <- lm(prestige ~ income + professional + income:professional, data = Prestige),
lm1 <- lm(prestige ~ income + professional + income:professional, data = Prestige)
summary(lm1)
nobs(lm1)  # 98 (4 NAs dropped listwise)
# (f) marginal effect of +$1000 income on prestige for professionals
0.0032 + -0.0023
# (f) marginal effect of +$1000 income on prestige for professionals
0.0032 + 0.0023
# (f) marginal effect of +$1000 income on prestige for professionals
0.0032 - 0.0023
# (f) marginal effect of +$1000 income on prestige for professionals
(0.0032 - 0.0023) * 1000
# (f) marginal effect of +$1000 income on prestige for professionals
(0.0031709 -0.0023257) * 1000
summary(lm1)
# (g) marginal effect of being professional when income = $6,000
37.7812800 + (-0.0023257 * 6000)
legend("bottomright", legend = c("Non-professional", "Professional"),
col = c("black", "red"), lwd = 2)
plot(Prestige$income, Prestige$prestige, col = Prestige$professional + 1,
xlab = "Income", ylab = "Prestige", main = "Prestige by income and occupation type")
plot(Prestige$income, Prestige$prestige, col = Prestige$professional + 1,
xlab = "Income", ylab = "Prestige", main = "Prestige by income and occupation type")
abline(b[1], b[2], col = "black", lwd = 2)
# visualising for fun
library(ggplot2)
# keep complete cases so the plotted points match the 98 used in lm1
Prestige_c <- Prestige[!is.na(Prestige$type), ]
Prestige_c$group <- factor(Prestige_c$professional,
levels = c(0, 1),
labels = c("Non-professional", "Professional"))
# prediction grid: each group over its own observed income range
grid <- do.call(rbind, lapply(0:1, function(p) {
r <- range(Prestige_c$income[Prestige_c$professional == p])
data.frame(income = seq(r[1], r[2], length.out = 100), professional = p)
}))
pred <- cbind(grid, predict(lm1, newdata = grid, interval = "confidence", level = 0.95))
pred$group <- factor(pred$professional, levels = c(0, 1),
labels = c("Non-professional", "Professional"))
ggplot() +
geom_point(data = Prestige_c, aes(x = income, y = prestige, colour = group), alpha = 0.6) +
geom_ribbon(data = pred, aes(x = income, ymin = lwr, ymax = upr, fill = group), alpha = 0.2) +
geom_line(data = pred, aes(x = income, y = fit, colour = group), linewidth = 1) +
labs(title = "Prestige by income and occupation type",
x = "Income (dollars)", y = "Prestige score",
colour = "Occupation", fill = "Occupation") +
theme_minimal()
b <- coef(lm1)
V <- vcov(lm1)
# restrict to incomes where both groups are observed (the overlap region)
inc <- seq(min(Prestige_c$income),
max(Prestige_c$income[Prestige_c$professional == 0]),
length.out = 200)
me <- b["professional"] + b["income:professional"] * inc
se <- sqrt(V["professional", "professional"] +
inc^2 * V["income:professional", "income:professional"] +
2 * inc * V["professional", "income:professional"])
tcrit <- qt(0.975, df = df.residual(lm1))
df_me <- data.frame(income = inc, me = me, lwr = me - tcrit * se, upr = me + tcrit * se)
ggplot(df_me, aes(x = income, y = me)) +
geom_ribbon(aes(ymin = lwr, ymax = upr), fill = "gray80", alpha = 0.6) +
geom_line(colour = "blue", linewidth = 1) +
geom_hline(yintercept = 0, linetype = "dotted") +
geom_vline(xintercept = 6000, linetype = "dashed") +
labs(title = "Marginal effect of being professional, by income",
x = "Income (dollars)",
y = "Difference in predicted prestige (professional - non-professional)") +
theme_minimal()
Prestige_c <- Prestige[!is.na(Prestige$type), ]
Prestige_c$group <- factor(Prestige_c$professional,
levels = c(0, 1),
labels = c("Non-professional", "Professional"))
# prediction grid: each group over its own observed income range
grid <- do.call(rbind, lapply(0:1, function(p) {
r <- range(Prestige_c$income[Prestige_c$professional == p])
data.frame(income = seq(r[1], r[2], length.out = 100), professional = p)
}))
pred <- cbind(grid, predict(lm1, newdata = grid, interval = "confidence", level = 0.95))
pred$group <- factor(pred$professional, levels = c(0, 1),
labels = c("Non-professional", "Professional"))
ggplot() +
geom_point(data = Prestige_c, aes(x = income, y = prestige, colour = group), alpha = 0.6) +
geom_ribbon(data = pred, aes(x = income, ymin = lwr, ymax = upr, fill = group), alpha = 0.2) +
geom_line(data = pred, aes(x = income, y = fit, colour = group), linewidth = 1) +
labs(title = "Prestige by income and occupation type",
x = "Income (dollars)", y = "Prestige score",
colour = "Occupation", fill = "Occupation") +
theme_minimal()
n <- 131
k <- 2
df_res <- n - k - 1 # 128
t_assigned <- 0.042 / 0.016
2 * pt(abs(t_assigned), df = df_res, lower.tail = FALSE)      # approx. 0.0097
0.042 + c(-1, 1) * qt(0.975, df_res) * 0.016 # 95% CI
# (b) adjacent lawn signs
0.042 / 0.013
t_assigned <- 0.042 / 0.016
# (b) adjacent lawn signs
t_adjacent <- 0.042 / 0.013
2 * pt(abs(t_adjacent), df = df_res, lower.tail = FALSE)
0.042 + c(-1, 1) * qt(0.975, df_res) * 0.013
# (c) constant term
0.302 / 0.011
