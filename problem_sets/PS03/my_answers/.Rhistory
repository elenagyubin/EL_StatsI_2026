# Why do you think this is the case?
############################## appendix ##############################
stargazer(lm1, lm3, lm5,
title = "Incumbent vote share (bivariate and multiple regressions)",
dep.var.labels = "Incumbent vote share",
covariate.labels = c("Log spending difference",
"Presidential vote share",
"Constant"),
header = FALSE, # no need for all the heading info
table.placement = "h", # places it right here
