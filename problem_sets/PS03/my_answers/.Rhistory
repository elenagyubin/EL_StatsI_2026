############################## question 1 ##############################
# 1. regression where the outcome variable is voteshare and the explanatory
# variable is difflog
lm1 <- lm(voteshare ~ difflog, data = inc.sub)
summary(lm1)
# 2. scatterplot of the two variables and the regression line
pdf("SP_lm1.pdf", width = 10, height = 7)
plot(inc.sub$difflog,inc.sub$voteshare,
xlab = "Log difference in campaign spending",
ylab = "Incumbent vote share")
abline(lm1, col = "deeppink", lwd = 0.8)
dev.off()
# 3. residuals of the model in a separate object
lm1_res <- lm1$residuals
# 4. the prediction equation
# predicted vote share = 0.579 + 0.042 * difflog
############################## question 2 ##############################
# 1. regression where the outcome variable is presvote and the explanatory
# variable is difflog.
lm2 <- lm(presvote ~ difflog, data = inc.sub)
summary(lm2)
# 2. scatterplot of the two variables and the regression line
pdf("SP_lm2.pdf", width = 10, height = 7)
plot(inc.sub$difflog, inc.sub$presvote,
xlab = "Log difference in campaign spending",
ylab = "Presidential vote share")
abline(lm2, col = "deeppink", lwd = 0.8)
dev.off()
# 3. residuals in a separate object
lm2_res <- lm2$residuals
# 4. prediction equation
# predicted pres-vote = 0.508 + 0.024 * difflog
############################## question 3 ##############################
# 1. regression with outcome variable voteshare and explanatory variable presvote
lm3 <- lm(voteshare ~ presvote, data = inc.sub)
summary(lm3)
# 2. scatterplot
pdf("SP_lm3.pdf", width = 10, height = 7)
plot(inc.sub$presvote, inc.sub$voteshare,
xlab = "Presidential vote share",
ylab = "Incumbent vote share")
abline(lm3, col = "deeppink", lwd = 0.8)
dev.off()
# 3. prediction equation
# predicted vote share = 0.441 + 0.388 * presvote
############################## question 4 ##############################
# 1. regression where the outcome variable is the residuals from Question 1 and
# the explanatory variable is the residuals from Question 2
