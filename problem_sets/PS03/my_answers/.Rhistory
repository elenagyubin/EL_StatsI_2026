lm2_res <- lm2$residuals
# 4. prediction equation
# predicted pres-vote = 0.508 + 0.024 * difflog
############################## question 3 ##############################
# 1. regression with outcome variable voteshare and explanatory variable presvote
lm3 <- lm(voteshare ~ presvote, data = inc.sub)
summary(lm3)
# 2. scatterplot
pdf("SP_lm3.pdf", width = 10, height = 6.5)
plot(inc.sub$presvote, inc.sub$voteshare,
xlab = "Presidential vote share",
ylab = "Incumbent vote share")
abline(lm3, col = "deeppink", lwd = 0.8)
dev.off()
# 3. prediction equation
# predicted vote share = 0.441 + 0.388 * presvote
############################## question 4 ##############################
# 1. regression where the outcome variable is the residuals from Question 1 and
# the explanatory variable is the residuals from Question 2
lm4 <- lm(lm1_res ~ lm2_res)
summary(lm4)
# 2. scatterplot of the two residuals and the regression line
pdf("SP_lm4.pdf", width = 10, height = 6.5)
plot(lm2_res, lm1_res,
xlab = "Presidential vote share | Log difference in campaign spending (residuals)",
ylab = "Incumbent vote share | Log difference in campaign spending (residuals)")
abline(lm4, col = "deeppink", lwd = 0.8)
dev.off()
# 3. prediction equation
# predicted residuals of lm1 = 0 + 0.257 * residuals of lm2
############################## question 5 ##############################
# 1. regression where the outcome variable is the incumbent's vote share and
# the explanatory variables are difflog and presvote
lm5 <- lm(voteshare ~ difflog + presvote, data = inc.sub)
summary(lm5)
# 2. prediction equation
# predicted voteshare = 0.449 + 0.036 * difflog + 0.257 * presvote
# 3. what is it in this output that is identical to the output in Question 4?
# Why do you think this is the case?
